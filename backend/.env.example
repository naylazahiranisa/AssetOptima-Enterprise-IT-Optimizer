# AssetOptima - Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=AssetOptima
APP_VERSION=1.0.0

# Security
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — explicit URL (takes priority over individual vars)
DATABASE_URL=

# Database — individual components (used if DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assetoptima
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection pool
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# CORS — frontend origin(s)
CORS_ORIGINS=["*"]

# External APIs
OPENAI_API_KEY=

# RAG / Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=assetoptima
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K_DEFAULT=5

# Document Management
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.csv,.md

# Logging
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
